{
  "name": "enso-desktop",
  "version": "1.0.0",
  "description": "",
  "lint-staged": {
    "**/*": ""
  },
  "type": "module",
  "scripts": {
    "build": "enso-build build",
    "build:ui": "enso-build build --ui",
    "start": "cd engine && python3 ./mach run --noprofile",
    "import": "npm run ffprefs && npm run import:dumps && enso-build import",
    "import:dumps": "python3 scripts/update_service_dumps.py",
    "export": "enso-build export",
    "init": "npm run download && npm run import && npm run bootstrap",
    "download": "enso-build download",
    "bootstrap": "enso-build bootstrap",
    "package": "enso-build package",
    "sync": "python3 scripts/update_ff.py",
    "sync:raw": "enso-build update",
    "sync:rc": "python3 scripts/update_ff.py --rc",
    "sync:l10n": "python3 scripts/update_ff.py --just-l10n",
    "pretty": "prettier . --write --cache && autopep8 -r --in-place scripts/ src/ --exclude src/enso/tests/",
    "lint": "npx eslint src/ && prettier . --check --cache",
    "lint:fix": "npm run pretty && npx eslint src/ --fix",
    "prepare": "husky",
    "reset-ff": "enso-build reset",
    "enso-build": "enso-build",
    "test": "python3 scripts/run_tests.py",
    "test:dbg": "python3 scripts/run_tests.py --jsdebugger --debug-on-failure",
    "ffprefs": "cd tools/ffprefs && cargo run --bin ffprefs -- ../../",
    "lc": "enso-build license-check",
    "lc:fix": "enso-build license-check --fix",
    "use-moz-src": "cd engine && ./mach use-moz-src",
    "ci": "enso-build ci --brand release --display-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enso-browser/desktop.git"
  },
  "hooks": {
    "pre-commit": "npm run prepare"
  },
  "keywords": [],
  "author": "",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/enso-browser/desktop/issues"
  },
  "homepage": "https://github.com/enso-browser/desktop#readme",
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@enso-browser/build": "file:../surfer",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.3.0",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-mozilla": "^4.3.3",
    "eslint-plugin-no-unsanitized": "4.1.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-spidermonkey-js": "file:tools/eslint-plugin-spidermonkey-js",
    "formal-git": "^1.2.9",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-sh": "^0.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
