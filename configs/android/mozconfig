# Android-specific build configuration for Enso Browser

# Use GeckoView as the application
ac_add_options --enable-application=mobile/android

# Target architecture
if test "$SURFER_COMPAT" = "aarch64"; then
  ac_add_options --target=aarch64-linux-android
elif test "$SURFER_COMPAT" = "arm"; then
  ac_add_options --target=armv7-linux-androideabi
elif test "$SURFER_COMPAT" = "x86_64"; then
  ac_add_options --target=x86_64-linux-android
fi

# Android SDK/NDK paths (set by mach bootstrap)
# ac_add_options --with-android-sdk="$ANDROID_SDK_ROOT"
# ac_add_options --with-android-ndk="$ANDROID_NDK_ROOT"

# Compiler setup
if test -d "$HOME/.mozbuild/clang/bin"; then
    export CC="$HOME/.mozbuild/clang/bin/clang"
    export CXX="$HOME/.mozbuild/clang/bin/clang++"
fi

if test "$ENSO_RELEASE"; then
  ac_add_options --enable-optimize
  ac_add_options --enable-release
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-tests
  ac_add_options --disable-geckodriver

  ac_add_options --enable-rust-simd

  export MOZ_LTO=cross,thin
  ac_add_options --enable-lto=cross,thin

  ac_add_options --enable-install-strip
  ac_add_options --enable-strip
fi

# Disable telemetry
mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
mk_add_options MOZ_TELEMETRY_REPORTING=
