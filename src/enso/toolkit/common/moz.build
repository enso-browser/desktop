XPIDL_SOURCES += [
    "nsIEnsoCommonUtils.idl",
]

EXPORTS.mozilla += [
    "EnsoCommonUtils.h",
    "EnsoShareInternal.h",
]

SOURCES += [
    "EnsoCommonUtils.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    DIRS += ["windows"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    DIRS += ["cocoa"]

FINAL_LIBRARY = "xul"
XPIDL_MODULE = "enso"
